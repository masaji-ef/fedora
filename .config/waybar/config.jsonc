{
    "position": "bottom",
    "height": 28,
    "spacing": 6,

    "modules-left": [],

    "modules-center": [
        "sway/mode",
        "sway/workspaces",
        "custom/layout",
        "pulseaudio",
        "clock",
        "network",
        "custom/bluetooth",
        "battery",
        "cpu",
        "memory",
        "custom/temp",
        "tray"
    ],

    "modules-right": [],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "format-icons": {
            "urgent": "!",
            "focused": "●",
            "default": "○"
        }
    },

    "sway/mode": {
        "format": "RESIZE MODE"
    },

    "clock": {
        "format": " {:%a %d %b %H:%M}",
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt>{calendar}</tt>"
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": " muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " {ipaddr}",
        "format-disconnected": " no net",
        "tooltip": true,
        "interval": 1
    },

    "custom/bluetooth": {
        "format": "{}",
        "exec": "if bluetoothctl show | grep -q 'Powered: yes'; then echo ' on'; else echo ' off'; fi",
        "interval": 1,
        "on-click": "bluetoothctl power toggle",
        "tooltip": "Click to toggle Bluetooth"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": " {time}",
        "format-icons": ["", "", "", "", ""]
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 1
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 1
    },

    "custom/temp": {
        "format": " {}°C",
        "exec": "sensors | grep 'Tctl' | awk '{print $2}' | cut -d'+' -f2 | cut -d'.' -f1 || echo 'N/A'",
        "interval": 1
    },

    "custom/layout": {
        "format": "{}",
        "exec": "swaymsg -t get_inputs | jq -r '.[] | select(.type == \"keyboard\") | .xkb_active_layout_name' | head -1 | sed 's/English (US)/🇺🇸/; s/Russian/🇷🇺/'",
        "interval": 1,
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
        "tooltip": "Click to switch layout"
    },

    "tray": {
        "spacing": 8,
        "icon-size": 22
    }
}
