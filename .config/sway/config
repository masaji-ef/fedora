# ============================================================================#
#  VARIABLES                                                                  #
# ============================================================================#
set $mod Mod1
set $term alacritty
set $browser firefox
set $wallpaper ~/_pics/bg1.png
set $screenshot_dir ~/_pics/shots

# ============================================================================#
#  APPEARANCE (borders, gaps, colors)                                         #
# ============================================================================#
default_border normal 4
default_floating_border none
gaps inner 0
gaps outer 0
title_align center
floating_modifier $mod normal

client.focused          #000000 #000000 #ffffff #d4b8ff #ff6b6b
client.focused_inactive #000000 #000000 #ffffff #8888aa #333355
client.unfocused        #000000 #000000 #ffffff #8888aa #1a1a1a
client.urgent           #000000 #000000 #ffffff #69db7c #000000
client.placeholder      #000000 #000000 #ffffff #000000 #000000
client.background       #111111

# ============================================================================#
#  OUTPUTS                                                                    #
# ============================================================================#
#output * bg $wallpaper fill

output DP-1 {
    mode 2560x1440@144Hz
    position 1080 0
    scale 1
    render_bit_depth 8
    transform normal
    adaptive_sync disabled
}

output HDMI-A-1 {
    mode 1920x1080@144Hz
    position 0 0
    scale 1
    render_bit_depth 8
    transform 270
    adaptive_sync disabled
}

# ============================================================================#
#  WORKSPACE (assignments, navigation, auto-assign)                           #
# ============================================================================#
# Monitor bindings
workspace 1 output HDMI-A-1
workspace 2 output DP-1
workspace 3 output DP-1
workspace 4 output DP-1
workspace 5 output DP-1
workspace 6 output DP-1
workspace 7 output DP-1
workspace 8 output DP-1
workspace 9 output DP-1
workspace 10 output DP-1

# Switch workspace
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# Auto-assign windows to workspaces
#assign [title="Picture in picture"] workspace 1
#assign [title="Picture-in-Picture"] workspace 1
#assign [app_id="Picture-in-Picture"] workspace 1
#assign [app_id="com.ayugram.desktop" title="Media viewer"] workspace 1
#assign [title="Media viewer"] workspace 1
#assign [window_type="dialog"] workspace 1


# Floating window rules
for_window [window_type="menu"] floating enable, border pixel 3, resize set 640 360, sticky enable
for_window [window_type="utility"] floating enable, border pixel 3, resize set 640 360, sticky enable
for_window [window_role="pop-up"] floating enable, border pixel 3, resize set 640 360, sticky enable
for_window [window_type="dialog"] floating enable, border pixel 3, resize set 640 360, sticky enable
for_window [title="Picture in picture"] floating enable, resize set 640 360, sticky enable, border pixel 3
for_window [title="Picture-in-Picture"] floating enable, resize set 640 360, sticky enable, border pixel 3
for_window [app_id="Picture-in-Picture"] floating enable, resize set 640 360, sticky enable, border pixel 3
for_window [app_id="com.ayugram.desktop" title="Media viewer"] floating enable, resize set 800 800, border pixel 3, fullscreen disable
for_window [title="Media viewer"] floating enable, resize set 800 800, border pixel 3, fullscreen disable

# ============================================================================#
#  INPUT (keyboard, mouse, cursor)                                            #
# ============================================================================#
input type:keyboard {
    xkb_layout "us,ru"
    xkb_options "grp:caps_toggle"
    repeat_rate 70
    repeat_delay 180
}

input type:pointer {
    accel_profile flat
    pointer_accel 0.2
}

seat * {
    xcursor_theme Adwaita 25
}

# ============================================================================#
#  WINDOW OPERATIONS (kill, fullscreen, layout, focus, move)                 #
# ============================================================================#
bindsym $mod+q kill
bindsym $mod+s fullscreen toggle
bindsym $mod+r layout toggle split
bindsym $mod+Tab focus mode_toggle
bindsym $mod+Shift+grave floating toggle

bindsym --to-code {
    $mod+h focus left
    $mod+j focus down
    $mod+k focus up
    $mod+l focus right
    $mod+Shift+h move left
    $mod+Shift+j move down
    $mod+Shift+k move up
    $mod+Shift+l move right
}

bindsym $mod+Ctrl+Left  move workspace to output left
bindsym $mod+Ctrl+Right move workspace to output right
bindsym $mod+Ctrl+Up    move workspace to output up
bindsym $mod+Ctrl+Down  move workspace to output down

# ============================================================================#
#  RESIZE MODE (with faster resize)                                          #
# ============================================================================#
mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym shift+h resize shrink width 50px
    bindsym shift+j resize grow height 50px
    bindsym shift+k resize shrink height 50px
    bindsym shift+l resize grow width 50px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+r mode "resize"

# ============================================================================#
#  LAUNCHERS                                                                  #
# ============================================================================#
bindsym $mod+Return exec alacritty
bindsym $mod+w exec firefox
bindsym $mod+e exec rofi -show combi -combi-modes drun
bindsym $mod+z exec ~/.local/bin/woomer --monitor DP-1 --output DP-1

# ============================================================================#
#  MEDIA & SCREENSHOTS                                                        #
# ============================================================================#
# Audio with notifications
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Brightness
#bindsym XF86MonBrightnessUp exec brightnessctl set +5%
#bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Screenshots (grim + wl-copy)
bindsym $mod+equal exec mkdir -p $screenshot_dir && grim -o DP-1 $screenshot_dir/$(date +'%Y-%m-%d-%H%M%S.png') && wl-copy < $screenshot_dir/$(date +'%Y-%m-%d-%H%M%S.png')
bindsym $mod+minus exec mkdir -p $screenshot_dir && grim -g "$(slurp)" - | wl-copy

# ============================================================================#
#  SYSTEM COMMANDS (lock, reload, exit)                                      #
# ============================================================================#
bindsym $mod+Ctrl+Shift+l exec swaylock -f -i $wallpaper
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaymsg exit

# ============================================================================#
#  AUTOSTART                                                                  #
# ============================================================================#
# Environment
exec systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK I3SOCK
exec dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP

# System services
exec /usr/libexec/xfce-polkit &
exec udiskie --notify --tray &
exec waybar -c ~/.config/waybar/config.jsonc > /dev/null 2>&1 &
exec /usr/libexec/xdg-desktop-portal &
exec /usr/libexec/xdg-desktop-portal-wlr &

# Apps & UI
exec /opt/TgWsProxy_linux_amd64 > /dev/null 2>&1 &
exec alacritty > /dev/null 2>&1 &
